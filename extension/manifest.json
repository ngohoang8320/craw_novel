{
  "manifest_version": 3,
  "name": "Bilinovel Chapter Capture (nội bộ)",
  "version": "1.0.0",
  "description": "Đọc lại nội dung chapter bạn đang xem trên bilinovel.com và gửi về tool local để build EPUB.",
  "host_permissions": [
    "https://www.bilinovel.com/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilinovel.com/novel/*/*.html"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bilinovel Chapter Capture"
  }
}
